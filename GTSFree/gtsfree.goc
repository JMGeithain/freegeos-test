/* Zeilen: Typ 1 = Überschrift, 0 = Text, 3 = eingerückt, 2 = Abstand */
static const char *modelNames[8];



/***********************************************************************
 *              Application-Ressource
 ***********************************************************************/

@start AppResource;

@object GenApplicationClass GTApp = {
    GI_visMoniker = list { @GTTextMoniker, @GTLargeIconMoniker,
                           @GTSmallIconMoniker, @GTMiniIconMoniker };
    GI_comp = @GTPrimary;
    gcnList(MANUFACTURER_ID_GEOWORKS, GAGCNLT_WINDOWS) = @GTPrimary;
    gcnList(MANUFACTURER_ID_GEOWORKS, MGCNLT_ACTIVE_LIST) = @GTPrintControl;
    gcnList(MANUFACTURER_ID_GEOWORKS, GAGCNLT_SELF_LOAD_OPTIONS) =
        @GTPrintControl;
    ATTR_GEN_APPLICATION_PRINT_CONTROL = @GTPrintControl;
    ATTR_GEN_HELP_FILE = "FGTest Hilfe";
}

@visMoniker GTTextMoniker = "FreeGEOS Test";

@end AppResource;

