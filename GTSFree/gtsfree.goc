/***********************************************************************
 *
 *  PROJEKT:   FreeGEOS Test 1.1
 *             FreeGEOS-Ausgabe von "GeoWorks 1.x Test" (GWTEST.GEO)
 *  DATEI:     gtsfree.goc
 *  LIZENZ:    MIT
 *
 *  Liest aus, auf welchem Rechner oder Emulator FreeGEOS laeuft, zeigt
 *  es auf 8 Seiten an, speichert, kopiert und druckt den Bericht und
 *  fuehrt vor, was mit dem FreeGEOS-SDK (GOC/C) moeglich ist.
 *
 *  Seiten wie im Original:
 *    1 Uebersicht  2 System  3 Speicher  4 Bildschirm  5 GEOS
 *    6 Leistung    7 Grafik  8 Eingabe   (+ Hilfe, Info)
 *
 *  Tasten wie im Original:
 *    1-8 Seite, N/Leertaste/P blaettern, Pfeile oder +/- rollen,
 *    M messen, S speichern, K kopieren, H/? Hilfe, I Info, Esc Uebersicht
 *
 *  Zeichensatz dieser Datei: GEOS (Mac Roman) wegen der Umlaute.
 *  Die UTF-8-Fassung liegt in quelle-utf8/ (tools/to_geos.sh wandelt um).
 *
 ***********************************************************************/

@include <stdapp.goh>

@include <Objects/vTextC.goh>
@include <Objects/helpCC.goh>
#include <Ansi/stdio.h>
#include <Ansi/string.h>
#include <sysstats.h>
#include <system.h>
#include <geode.h>
#include <timedate.h>
#include <disk.h>
#include <file.h>
#include <initfile.h>
#include <localize.h>
#include <gstring.h>
#include <font.h>
#include <sound.h>

/***********************************************************************
 *              Konstanten
 ***********************************************************************/

#define APP_VERSION     "1.1"

#define PAGE_W          640
#define PAGE_H          460

/* Seiten */
#define PG_UEBERSICHT   0
#define PG_SYSTEM       1
#define PG_SPEICHER     2
#define PG_BILDSCHIRM   3
#define PG_GEOS         4
#define PG_LEISTUNG     5
#define PG_GRAFIK       6
#define PG_EINGABE      7
#define PG_SCHRIFTEN    8
#define PG_KLANG        9

/* Hilfedatei in USERDATA\HELP (GEOS-Name, in GeoWrite erstellt) */
#define HELP_FILE       "FGTest Hilfe"
#define NUM_TABS        10
#define NUM_REPORT      6       /* Seiten 0-5 bilden den Bericht */

/* Schrift der Bildschirmdarstellung: Systemschrift Esquire (ESQUIRE.FNT,
 * Font-ID 555 = 0x022B; Bitmapgroessen 9, 10, 12, 14, 18 Punkt).
 * Der Druck verwendet weiter URW Sans (Umrissschrift). */
#define FONT_SCREEN     screenFont
#define FONT_PRINT      FID_DTC_URW_SANS
/* bis zu dieser Vergroesserung reicht Esquire (max. 18 Punkt), darueber
 * wird auf die Umrissschrift URW Sans umgeschaltet (Variante A) */
#define ESQUIRE_MAX_SCALE 0x16666L      /* 1,4 */
/* kleiner wird die Seite nicht (Esquire gibt es erst ab 9 Punkt);
 * ist das Fenster kleiner, erscheinen Rollbalken */
#define MIN_SCALE       0x10000L        /* 1,0 = 640 x 460 */

/* Bildaufbau */
#define TITLE_H         30
#define TAB_Y           36
#define TAB_H           22
#define TAB_W           62
#define BODY_TOP        (TAB_Y + TAB_H)
#define BODY_BOTTOM     436
#define FOOT_Y          442
#define ROW_H           15
#define ROW_Y           (BODY_TOP + 6)
#define VIS_ROWS        ((BODY_BOTTOM - 6 - ROW_Y) / ROW_H)

/* Seite Schriften */
#define FONT_ROW_H      22
#define FONT_LIST_Y     (ROW_Y + 38)    /* unter Titel und Spaltenkoepfen */
#define FONT_VIS_ROWS   ((BODY_BOTTOM - 6 - FONT_LIST_Y) / FONT_ROW_H)
#define MAX_FONT_LIST   200
#define MAX_FONT_SIZES  8
#define MAX_TTF_MISSING 40

/* Seite Klang */
#define SONG_MAX        300
#define KL_BTN_W        146
#define KL_BTN_H        26
#define KL_ROW1_Y       214
#define KL_ROW2_Y       284
#define VALUE_X         240

/* Leistungsseite */
#define BTN_LEFT        480
#define BTN_TOP         (BODY_BOTTOM - 30)
#define BTN_RIGHT       624
#define BTN_BOTTOM      (BODY_BOTTOM - 8)
#define B_TICKS         30      /* je Test etwa 0,5 Sekunden */

/* Eingabeseite: Malflaeche */
#define PAD_LEFT        330
#define PAD_TOP         246
#define PAD_RIGHT       624
#define PAD_BOTTOM      428
#define MAX_POINTS      1000
#define STROKE_BREAK    (-1)
#define MAX_KEYS        12

/* Bericht */
