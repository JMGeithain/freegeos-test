static word         numKeys     = 0;
static word         keyNr       = 0;
static sword        mouseX = 0, mouseY = 0;
static sword        clickX = -1, clickY = -1;
static word         clicks = 0, ends = 0, drags = 0;
static word         lastBP = 0;

/* Puffer fuer VESA-Abfragen */
static byte         vbeInfo[512];
static byte         vbeMode[256];

/* Programmsymbol als Bitmap (aus GTS1ICON.PCX) */
#include "gtsicon.h"

/***********************************************************************
