#define LABEL_LEN       32
#define VALUE_LEN       64
#define RK_ROW          0
#define RK_HEAD         1

/* Druck (Einheit Punkt, A4) */
#define PR_W            595
#define PR_H            842
#define PR_MARGIN       40

/***********************************************************************
 *              Prozessorabfrage (386+) als Maschinencode
 *  Watcom "#pragma aux" mit Bytefolgen: so laeuft es auch, wenn der
 *  Compiler auf 8086-Code eingestellt ist.
 ***********************************************************************/

/*
 * Rueckgabe in BX: 0 = 80386, 1 = 80486 ohne CPUID, 2 = CPUID vorhanden.
 * Nur aufrufen, wenn der Kernel mindestens einen 80386 meldet.
 *   cli / pushfd / pop eax / mov ecx,eax / xor eax,40000h (AC) / ...
 */
extern word Cpu386Probe(void);
#pragma aux Cpu386Probe = \
    0xfa \
    0x66 0x9c 0x66 0x58 0x66 0x8b 0xc8 \
    0x66 0x35 0x00 0x00 0x04 0x00 \
    0x66 0x50 0x66 0x9d 0x66 0x9c 0x66 0x58 \
    0x66 0x33 0xc1 0x66 0x51 0x66 0x9d \
    0x33 0xdb \
    0x66 0xa9 0x00 0x00 0x04 0x00 \
    0x74 0x22 \
    0x43 \
    0x66 0x8b 0xc1 \
    0x66 0x35 0x00 0x00 0x20 0x00 \
    0x66 0x50 0x66 0x9d 0x66 0x9c 0x66 0x58 \
    0x66 0x33 0xc1 0x66 0x51 0x66 0x9d \
    0x66 0xa9 0x00 0x00 0x20 0x00 \
    0x74 0x01 \
    0x43 \
    0xfb \
    value [bx] \
    modify [ax bx cx];

/*
 * CPUID mit Funktion (hi:lo) -> out[0..3] = EAX, EBX, ECX, EDX
 *   shl edx,16 / movzx eax,ax / or eax,edx / xor ecx,ecx / cpuid /
 *   mov es:[di],eax / mov es:[di+4],ebx / mov es:[di+8],ecx / mov es:[di+12],edx
 */
extern void CpuidRaw(dword *out, word lo, word hi);
#pragma aux CpuidRaw = \
    0x66 0xc1 0xe2 0x10 \
    0x66 0x0f 0xb7 0xc0 \
    0x66 0x0b 0xc2 \
    0x66 0x33 0xc9 \
    0x0f 0xa2 \
    0x26 0x66 0x89 0x05 \
    0x26 0x66 0x89 0x5d 0x04 \
    0x26 0x66 0x89 0x4d 0x08 \
    0x26 0x66 0x89 0x55 0x0c \
    parm [es di] [ax] [dx] \
    modify [ax bx cx dx];

/* Text aus der Ressource StringsUI (bleibt waehrend der Laufzeit gesperrt) */
#define STR(o) ((char *) LMemDeref(o))

#define FARPTR(seg, off) ((byte *) ((((dword) (seg)) << 16) | (word) (off)))

/***********************************************************************
 *              Datentypen
 ***********************************************************************/

typedef struct {
    byte    RR_page;
    byte    RR_kind;
    char    RR_label[LABEL_LEN];
    char    RR_value[VALUE_LEN];
} ReportRow;

typedef struct {
    sword   SP_x;
    sword   SP_y;
} StrokePoint;

/* zusaetzliche Angaben je Schrift (Seite Schriften) */
typedef struct {
    byte    FX_outline;                 /* Umrissschrift vorhanden */
    byte    FX_numSizes;                /* Bitmapgroessen aus der .FNT-Datei */
    byte    FX_sizes[MAX_FONT_SIZES];
    char    FX_file[18];                /* DOS-Dateiname, z. B. LED.FNT oder
                                           TTF\DEJAVU.TTF */
    byte    FX_ttfFiles;                /* Zahl der TTF-Dateien (Schnitte) */
} FontExtra;

/* TrueType-Datei, die FreeGEOS nicht als Schrift geladen hat */
typedef struct {
    char    TM_file[14];
    char    TM_family[32];
} TtfMissing;

typedef struct {
    word    KE_nr;
    word    KE_char;
    word    KE_flags;
} KeyEntry;

typedef struct {
    /* Prozessor */
    word    cpu;                /* Klasse: 0..4, 5, 6, 15 */
    Boolean cpuid;
    char    vendor[13];
    word    fam, mod, step;
    char    brand[49];
    dword   feat;
    Boolean fpu;
    word    kernSpeed;          /* Kernel: Verhaeltnis zum PC/XT * 10 */
    dword   loops;              /* eigene Messung: Schleifen pro Sekunde */
    /* BIOS / Emulator */
    char    emu[32];
    Boolean isEmu;
    char    biosId[VALUE_LEN];
    char    biosDate[9];
    byte    modelByte;
    word    equip;
    word    com[4];
    word    lpt[3];
    byte    hdd;
    byte    kbd;
    /* DOS */
    byte    dosMaj, dosMin, dosOem;
    Boolean trueOk;
    byte    trueMaj, trueMin;
    byte    curDrive;
    byte    winMaj, winMin;
    char    comspec[VALUE_LEN];
    char    blaster[VALUE_LEN];
    /* Speicher */
    word    conv;
    word    cmosExt;
    Boolean int15ok;
    word    int15;
    Boolean xms;
    word    xmsVer, xmsRev, xmsLarge, xmsFree;
    Boolean ems;
    byte    emsVer;
    word    emsFree, emsTotal;
    /* Video */
    word    vmode, vcols;
    Boolean vbe;
    word    vbeVer, vbeMem;
    char    vbeOem[48];
    char    vbeVendor[40];
    char    vbeProduct[40];
    word    vmodeV;
    Boolean miOk;
    word    xres, yres, bpp;
} HwInfo;

/***********************************************************************
 *              Klassen
 ***********************************************************************/

@class GTProcessClass, GenProcessClass;
    @message void MSG_GT_PROCESS_SAVE_REPORT();
    @message void MSG_GT_PROCESS_COPY_REPORT();
@endc;

/* Content: leitet die Tastatur an die Seite weiter */
@class GTContentClass, VisContentClass;
@endc;

/* Die Seite: eigene Vis-Klasse mit Mausgriff (wie im Original) */
@class GTPageClass, VisClass;
    @message (GEN_ITEM_GROUP_APPLY_MSG) MSG_GT_PAGE_MENU_PAGE;
    @message void MSG_GT_PAGE_SET_PAGE(word page);
    @message void MSG_GT_PAGE_MEASURE();
    @message void MSG_GT_PAGE_HELP();
    @message void MSG_GT_PAGE_INFO();
    @message void MSG_GT_PAGE_STATUS(const char *msg);
    @message void MSG_GT_PAGE_KEY(word character, word flags);
    @instance byte GTPI_drawing = 0;
@endc;

@classdecl GTProcessClass, neverSaved;
@classdecl GTContentClass;
@classdecl GTPageClass;

